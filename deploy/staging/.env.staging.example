# Real staging only. Copy to .env on the staging host; never commit real values.
SECRET_KEY=REPLACE_LOCALLY
DEBUG=False
ALLOWED_HOSTS=staging.zomorodmelal.ir
CSRF_TRUSTED_ORIGINS=https://staging.zomorodmelal.ir

SAEIT_ENV=staging
DATABASE_URL=postgresql://STAGING_DB_USER:STAGING_DB_PASSWORD@127.0.0.1:5432/zomorod2_saeit_stg
STAGING_DB_IDENTITY=zomorod2_saeit_stg
# Set to the real Production DB identity/name; it MUST differ from staging.
PRODUCTION_DB_IDENTITY=REPLACE_WITH_PRODUCTION_DB_IDENTITY

SAEIT_BRIDGE_SECRET=REPLACE_LOCALLY_WITH_LONG_RANDOM_SECRET

# Must resolve to a configured network-backed provider whose class declares real_research=True.
FACTORY_RESEARCH_PROVIDER=REPLACE_WITH_REAL_STAGING_SAFE_PROVIDER_CLASS
FACTORY_RESEARCH_PROVIDER_TIER=staging
STAGING_RESEARCH_API_KEY=REPLACE_LOCALLY

PRODUCTION_PUBLICATION_ENABLED=False
REAL_PAYMENTS_ENABLED=False
TREASURY_EXECUTION_ENABLED=False
CRYPTO_EXECUTION_ENABLED=False

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
