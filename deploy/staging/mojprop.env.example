# MOJ PROP staging-only environment template
# Never commit real URLs, passwords, tokens, or digest secrets.
# Keep the alias disabled until the dedicated target database exists.

SAEIT_ENV=staging
MPW_MOJPROP_DB_ALIAS_ENABLED=false
MPW_MOJPROP_DEPLOYMENT_ENV=staging
MPW_MOJPROP_DATABASE_URL=
MPW_MOJPROP_IDENTITY_DIGEST_SECRET=
MPW_MOJPROP_RECONCILIATION_SOURCE_ALIAS=default

# These remain closed during database preparation and canary verification.
MPW_MOJPROP_PLAN1_ROUTE_ENABLED=false
MPW_MOJPROP_PLAN1_LIVE_INVOICE_ENABLED=false
MPW_MOJPROP_ENGLISH_ROUTE_ENABLED=false
