# Copy to .env on the server and replace every placeholder with real values.
# Never commit the production .env or real credentials.

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME

# HTTPS / security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Application
APP_VERSION=1.0.0

# Internal Saeit Bridge (generate a long random production secret; never commit it)
SAEIT_BRIDGE_SECRET=

# Optional AI integration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6

# MojPlayWin native TRX: ALL payment/release settings remain OFF by default.
# Do not set any release/approval flag TRUE until real server, receiver,
# rights, product-file, chain-verification and owner evidence is reviewed.
# Live walletless TRX additionally requires DEBUG=False, HTTPS MojPlayWin host,
# default DATABASE_URL backed by MariaDB/MySQL (the generic PostgreSQL example
# above is not valid for this specific payment adapter), and a private asset
# directory OUTSIDE the web root. Check the actual receiver in
# mpw_commerce/invoicing.py; the source constant is not proof of wallet control.
MPW_COMMERCE_RELEASE_READY=False
MPW_COMMERCE_DOWNLOADS_ENABLED=False
MPW_COMMERCE_PRIVATE_ASSET_ROOT=
MPW_WALLETLESS_TRX_PUBLIC_ENABLED=False
MPW_WALLETLESS_TRX_MERCHANT_CANARY_PASSED=False
MPW_WALLETLESS_TRX_PUBLIC_RELEASE_AUTHORIZED=False
# Comma-separated approved numeric DB IDs only (empty means no public offers).
MPW_TRX_PUBLIC_PRODUCT_IDS=
