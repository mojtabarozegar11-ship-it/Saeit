# Copy to .env on the server and replace every placeholder with real values.
# Never commit the production .env or real credentials.

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME

# HTTPS / security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Application
APP_VERSION=1.0.0

# Internal Saeit Bridge (generate a long random production secret; never commit it)
SAEIT_BRIDGE_SECRET=

# Optional AI integration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6


# Explicit runtime identity: development | test | ci | staging | production
SAEIT_ENV=development

# Real isolated staging (names/placeholders only; never commit real values)
STAGING_DB_IDENTITY=saeit_staging
PRODUCTION_DB_IDENTITY=saeit_production
FACTORY_RESEARCH_PROVIDER=
# staging = REAL-STAGING-SAFE; sandbox = SANDBOX; fixture = FIXTURE/CI-ONLY; production = PRODUCTION-ONLY
FACTORY_RESEARCH_PROVIDER_TIER=
PRODUCTION_PUBLICATION_ENABLED=False
REAL_PAYMENTS_ENABLED=False
TREASURY_EXECUTION_ENABLED=False
CRYPTO_EXECUTION_ENABLED=False
