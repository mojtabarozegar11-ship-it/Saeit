# Copy to .env on the server and replace every placeholder with real values.
# Never commit the production .env or real credentials.

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME

# HTTPS / security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Application
APP_VERSION=1.0.0

# Internal Saeit Bridge (generate a long random production secret; never commit it)
SAEIT_BRIDGE_SECRET=

# Optional AI integration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6
# Unified native TRX checkout: all flags FALSE until independent on-chain acceptance.
# Never commit actual wallet secrets or an API key; only the public receiver address.
TRON_UNIFIED_PUBLIC_ENABLED=False
TRON_UNIFIED_DISCOVERY_ENABLED=False
TRON_UNIFIED_SHARED_RATE_LIMIT_READY=False
TRON_UNIFIED_RECEIVER=
TRON_UNIFIED_ALLOWED_HOSTS=
TRON_UNIFIED_PRIVATE_DIGITAL_ROOT=
TRON_UNIFIED_TRONGRID_API_KEY=
TRON_UNIFIED_CACHE_URL=
