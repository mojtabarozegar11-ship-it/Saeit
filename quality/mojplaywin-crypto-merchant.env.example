# MojPlayWin ETH/TRX merchant pre-activation template.
# PUBLIC receiving addresses transcribed from owner-provided Trust Wallet screenshots.
# IMPORTANT: Confirm EACH address in the wallet app before using it for receipts.
# This file is documentation: it is NOT loaded by Django and must not be
# committed as a live server .env. Private keys / seed phrases must never be entered.
MOJPLAYWIN_CRYPTO_ENABLED=False

# Native Ethereum mainnet (ETH only)
MOJPLAYWIN_ETH_ADDRESS=0x89149b01f59115B86553561F12438D2ADF517E75
# Set a vetted, verified Ethereum mainnet HTTPS JSON-RPC; NOT a placeholder.
MOJPLAYWIN_ETH_RPC_URL=
MOJPLAYWIN_ETH_CONFIRMATIONS=12

# Native TRON mainnet (TRX only). No memo required in supplied wallet.
MOJPLAYWIN_TRX_ADDRESS=THFNU1iEXHd71WjEgjqUksd2UnMg2pUi73
# Optional secret from approved TronGrid provider: keep server-side ONLY.
MOJPLAYWIN_TRONGRID_API_KEY=
MOJPLAYWIN_TRX_CONFIRMATIONS=20

# Use a private path OUTSIDE ALL site roots. Must contain approved sale files.
MOJPLAYWIN_PRIVATE_ASSET_ROOT=

# Activation is blocked until isolated deployment, backup restore test,
# price & merchant address approvals and real payment end-to-end verification.
